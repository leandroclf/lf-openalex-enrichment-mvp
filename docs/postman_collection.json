          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Verifica se o serviço está operacional. Use este endpoint em monitoramentos e health checks de infraestrutura.\n\n**Resposta esperada:** `{\"status\":\"ok\",\"service\":\"lf-openalex-enrichment-mvp\"}`"
          },
          "response": [
