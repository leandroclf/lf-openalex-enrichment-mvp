                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"accountId\": \"beta-002\",\n  \"score\": 65\n}"
                },
                "url": {
                  "raw": "{{base_url}}/v1/value-score",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "value-score"]
                }
