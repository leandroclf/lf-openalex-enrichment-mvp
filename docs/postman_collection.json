{
  "info": {
    "_postman_id": "lf-openalex-enrichment-mvp-collection",
    "name": "lf-openalex-enrichment-mvp",
    "description": "Coleção completa da API de Enriquecimento B2B com OpenAlex.\n\nPermite enriquecer leads, calcular scores de valor e priorizar prospects por gap de enriquecimento.\n\n**URL de Produção:** https://lf-openalex-enrichment-mvp.onrender.com\n\nImporte também o environment `postman_environment.json` para configurar as variáveis `{{base_url}}` e `{{base_url_local}}`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://lf-openalex-enrichment-mvp.onrender.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Endpoints para verificação de saúde e disponibilidade do serviço.",
      "item": [
